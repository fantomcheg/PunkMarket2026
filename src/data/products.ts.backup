const smartphoneModels = {
  Samsung: ['Galaxy S24 Ultra', 'Galaxy S24+', 'Galaxy S24', 'Galaxy Z Fold 5', 'Galaxy Z Flip 5', 'Galaxy A54', 'Galaxy A34', 'Galaxy M54'],
  Apple: ['iPhone 15 Pro Max', 'iPhone 15 Pro', 'iPhone 15 Plus', 'iPhone 15', 'iPhone 14 Pro', 'iPhone 14', 'iPhone 13', 'iPhone SE'],
  Xiaomi: ['14 Ultra', '14 Pro', '14', '13T Pro', '13T', 'Redmi Note 13 Pro', 'Redmi Note 13', 'Poco X6 Pro'],
  OPPO: ['Find X7 Pro', 'Find X7', 'Reno 11 Pro', 'Reno 11', 'A79', 'A59', 'A18', 'A38'],
  Realme: ['GT 5 Pro', 'GT 5', '12 Pro+', '12 Pro', '12', 'C67', 'C55', 'C53'],
  OnePlus: ['12 Pro', '12', '11T', '11', 'Nord 3', 'Nord CE 3', 'Nord N30', 'Nord N20'],
  Google: ['Pixel 8 Pro', 'Pixel 8', 'Pixel 7a', 'Pixel 7 Pro', 'Pixel 7', 'Pixel Fold'],
  Motorola: ['Edge 40 Pro', 'Edge 40', 'G84', 'G54', 'G34', 'E13'],
};

const storageOptions = ['64GB', '128GB', '256GB', '512GB', '1TB'];
const ramOptions = ['4GB', '6GB', '8GB', '12GB', '16GB'];
const colors = ['Черный', 'Белый', 'Синий', 'Зеленый', 'Фиолетовый', 'Серый'];
const screenSizes = ['6.1"', '6.4"', '6.7"', '6.8"'];

let productId = 1;

smartphoneBrands.forEach((brand, brandIndex) => {
  const models = smartphoneModels[brand as keyof typeof smartphoneModels];
  const productsPerBrand = Math.ceil(40 / smartphoneBrands.length);
  
  // Фолбэк изображения для каждого бренда
  const brandImages: { [key: string]: string } = {
    'Samsung': '1610945415295-d9bbf067e59c',  // Samsung phone
    'Apple': '1511707171634-5f897ff02aa9',     // iPhone
    'Xiaomi': '1610945415295-d9bbf067e59c',    // Smartphone
    'OPPO': '1610945415295-d9bbf067e59c',      // Generic smartphone
    'Realme': '1511707171634-5f897ff02aa9',    // Generic smartphone
    'OnePlus': '1610945415295-d9bbf067e59c',   // Generic smartphone
    'Google': '1511707171634-5f897ff02aa9',    // Pixel phone
    'Motorola': '1610945415295-d9bbf067e59c',  // Generic smartphone
  };
  
  for (let i = 0; i < Math.min(productsPerBrand, models.length); i++) {
    const model = models[i];
    const itemId = productId;
    const storage = storageOptions[itemId % storageOptions.length];
    const ram = ramOptions[itemId % ramOptions.length];
    const screen = screenSizes[itemId % screenSizes.length];
    const color = colors[itemId % colors.length];
    
    const basePrice = brand === 'Apple' ? 80000 + (seededRandom(itemId * 10) * 70000) :
                      brand === 'Samsung' && model.includes('Ultra') ? 70000 + (seededRandom(itemId * 10) * 50000) :
                      brand === 'Samsung' ? 30000 + (seededRandom(itemId * 10) * 40000) :
                      brand === 'Xiaomi' && model.includes('Ultra') ? 60000 + (seededRandom(itemId * 10) * 20000) :
                      brand === 'OnePlus' && model.includes('Pro') ? 50000 + (seededRandom(itemId * 10) * 30000) :
                      brand === 'Google' ? 40000 + (seededRandom(itemId * 10) * 60000) :
                      15000 + (seededRandom(itemId * 10) * 35000);
    
    // Проверяем наличие локального изображения по полному названию товара
    const fullTitle = `Смартфон ${brand} ${model} ${storage}`;
    
    electronicsProducts.push(generateProduct(
      productId++,
      fullTitle,
      Math.floor(basePrice),
      1,
      'Электроника',
      {
        brand,
        storage,
        ram,
        screen,
        color,
      }
    ));
  }
});

