export interface Product {
  id: string;
  title: string;
  price: number;
  oldPrice?: number;
  rating: number;
  reviews: number;
  image: string;
  badge?: string;
  inStock: boolean;
  categoryId: number;
  category: string;
  // Расширенные поля для фильтров (уязвимости!)
  brand?: string;
  color?: string;
  storage?: string;  // Память (для смартфонов/ноутбуков)
  ram?: string;      // ОЗУ
  screen?: string;   // Диагональ экрана
  processor?: string; // Процессор
  warranty?: number;  // Гарантия (месяцы)
  seller?: string;    // Продавец (для IDOR)
  discount?: number;  // Скидка в %
}

// Детерминированная функция генерации случайных чисел на основе seed
function seededRandom(seed: number): number {
  const x = Math.sin(seed) * 10000;
  return x - Math.floor(x);
}

// Вспомогательная функция для генерации товаров
function generateProduct(
  id: number,
  title: string,
  basePrice: number,
  categoryId: number,
  category: string,
  options: Partial<Product> = {}
): Product {
  // Используем id как seed для детерминированной генерации
  const rand1 = seededRandom(id * 1);
  const rand2 = seededRandom(id * 2);
  const rand3 = seededRandom(id * 3);
  const rand4 = seededRandom(id * 4);
  const rand5 = seededRandom(id * 5);
  const rand6 = seededRandom(id * 6);
  const rand7 = seededRandom(id * 7);
  
  const hasDiscount = rand1 > 0.7;
  const discountPercent = hasDiscount ? Math.floor(rand2 * 40) + 10 : 0;
  const price = Math.floor(basePrice);
  const oldPrice = hasDiscount ? Math.floor(basePrice / (1 - discountPercent / 100)) : undefined;
  
  const badges = hasDiscount ? ['Скидка', 'Хит продаж', 'Супер цена'] : ['Новинка', 'Хит продаж', null];
  const badge = rand3 > 0.6 ? badges[Math.floor(rand4 * badges.length)] : undefined;
  
  // Генерируем дефолтный image - сначала пробуем по ID, потом фолбэк
  const imageById = `/images/${id}.png`;
  const defaultImage = options.image || imageById;
  
  return {
    id: id.toString(),
    title,
    price,
    oldPrice: oldPrice || undefined,
    rating: +(rand5 * 1 + 4).toFixed(1), // 4.0-5.0
    reviews: Math.floor(rand6 * 5000) + 50,
    image: defaultImage,
    badge,
    inStock: rand7 > 0.1, // 90% в наличии
    categoryId,
    category,
    discount: discountPercent || undefined,
    warranty: [12, 24, 36][id % 3],
    seller: ['OmniMarket', 'TechStore', 'ElectroPlus', 'GadgetHub'][id % 4],
    ...options,
  };
}

// ===== КАТЕГОРИЯ 1: ЭЛЕКТРОНИКА (100 товаров) =====
const electronicsProducts: Product[] = [];

// Смартфоны (40 товаров)
