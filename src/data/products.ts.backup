  if (mouseModels[brand]) {
    const models = mouseModels[brand];
    
    // Релевантные изображения мышей
    const mouseImages = [
      '1527814050087-3793815479db',  // Mouse closeup
      '1615663245857-ac93bb7c39e7',  // Gaming mouse
    ];
    
    models.slice(0, 2).forEach(model => {
      const itemId = productId;
      const basePrice = 5000 + seededRandom(itemId * 11) * 15000;
      computerProducts.push(generateProduct(
        productId++,
        `Мышь ${model.includes('Wireless') || model.includes('Pro') ? 'беспроводная' : 'игровая'} ${brand} ${model}`,
        Math.floor(basePrice),
        2,
        'Компьютеры',
        {
          brand,
          color: ['Черный', 'Белый'][Math.floor(seededRandom(itemId * 11) * 2)],
          image: `https://images.unsplash.com/photo-${mouseImages[itemId % mouseImages.length]}?w=400&h=400&fit=crop`,
        }
      ));
    });
  }
});

// Веб-камеры, микрофоны и аксессуары (15 товаров)
const accessories = [
  { type: 'Веб-камера', brands: ['Logitech', 'Razer', 'Elgato'], models: ['C920 Pro HD', 'C922 Pro Stream', 'Brio 4K', 'Kiyo Pro', 'Facecam Pro'] },
  { type: 'Микрофон', brands: ['Blue', 'HyperX', 'Razer', 'Elgato'], models: ['Yeti X', 'QuadCast S', 'Seiren V3 Chroma', 'Wave:3'] },
  { type: 'Наушники игровые', brands: ['HyperX', 'SteelSeries', 'Logitech', 'Razer'], models: ['Cloud III Wireless', 'Arctis Nova Pro', 'G Pro X 2', 'BlackShark V2 Pro'] },
];

accessories.forEach((accessory, idx) => {
  const count = Math.ceil(15 / accessories.length);
  
  // Релевантные изображения для аксессуаров
  const accessoryImages: { [key: string]: string } = {
    'Веб-камера': '1614624532983-4ce03382d63d',
    'Микрофон': '1590602847861-f357a9332bbc',
    'Наушники игровые': '1505740420928-5e560c06d30e',  // Headphones
  };
  
  for (let i = 0; i < count && i < accessory.models.length; i++) {
    const itemId = productId;
    const brand = accessory.brands[i % accessory.brands.length];
    const model = accessory.models[i];
    const basePrice = accessory.type === 'Веб-камера' ? 5000 + seededRandom(itemId * 11) * 15000 :
                      accessory.type === 'Микрофон' ? 10000 + seededRandom(itemId * 11) * 20000 :
                      8000 + seededRandom(itemId * 11) * 20000;
    
    computerProducts.push(generateProduct(
      productId++,
      `${accessory.type} ${brand} ${model}`,
      Math.floor(basePrice),
      2,
      'Компьютеры',
      {
        brand,
        color: ['Черный', 'Белый'][Math.floor(seededRandom(itemId * 11) * 2)],
        image: `https://images.unsplash.com/photo-${accessoryImages[accessory.type]}?w=400&h=400&fit=crop`,
      }
    ));
  }
});

console.log(`✅ Создано ${computerProducts.length} товаров для категории Компьютеры`);


